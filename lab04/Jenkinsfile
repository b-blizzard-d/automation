pipeline {
    agent {
        label 'php-agent'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                // ставим зависимости (phpunit) композером
                echo 'Preparing project...'
                sh 'cd lab04/tip-splitter && composer install'
            }
        }

        stage('Test') {
            steps {
                // гоняем тесты
                echo 'Running tests...'
                sh 'cd lab04/tip-splitter && vendor/bin/phpunit tests'
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
        }
        success {
            echo 'All stages completed successfully!'
        }
        failure {
            echo 'Errors detected in the pipeline.'
        }
    }
}
